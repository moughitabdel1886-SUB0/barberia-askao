# Barbería Askao — variables de entorno
# Copia este archivo como .env para desarrollo local.
# En Manus, DATABASE_URL y las variables MANUS_* las inyecta la plataforma.

# Servidor
PORT=3000
# En local: development. En producción: production (el Dockerfile ya lo fija).
# NODE_ENV=development
# En Docker directo pon false para no confiar en X-Forwarded-For del cliente.
# En Manus/Vercel/Render detrás de un proxy, deja 1 o el número de saltos.
TRUST_PROXY=1

# Base de datos MySQL 8 (obligatoria fuera de Manus)
DATABASE_URL=mysql://usuario:contraseña@127.0.0.1:3306/askao
# En producción puedes ejecutar las migraciones una sola vez con un usuario
# migrador y arrancar el servidor con RUN_MIGRATIONS=0.
RUN_MIGRATIONS=1

# Primer acceso del panel (opcional).
# Si defines ambas, el administrador se crea al arrancar y el formulario de
# primer acceso deja de mostrarse. Usa una contraseña larga y única.
ADMIN_EMAIL=barberiaaskao@gmail.com
ADMIN_PASSWORD=
# Si no defines ADMIN_PASSWORD, el primer acceso pide este token.
# Si lo dejas vacío, se genera uno aleatorio y se imprime en los logs del
# servidor al arrancar. Defínelo en producción para que sea estable.
ADMIN_SETUP_TOKEN=

# Emails de reserva con Resend (https://resend.com).
# Sin RESEND_API_KEY las reservas se guardan y los emails quedan en cola
# visibles en /admin → Ajustes; no se pierde ningún dato.
RESEND_API_KEY=
EMAIL_FROM="Barbería Askao <citas@barberia-askao.com>"

# Almacenamiento gestionado de Manus (solo necesario fuera de Manus).
# En Manus se inyectan automáticamente. Fuera de Manus, usa estas claves o
# adapta server/storage.ts a tu proveedor S3/R2.
MANUS_API_URL=
MANUS_API_KEY=
# En Manus déjalo en 0: la plataforma ya sirve /manus-storage/.
# Fuera de Manus, ponlo en 1 para que el servidor haga de proxy de las imágenes.
MANUS_STORAGE_PROXY=0
